# Copy to .env and fill in. Never commit the real .env.

# Gemini 2.0 Flash — heavy reasoning, vision, meeting summaries
GEMINI_API_KEY=

# Picovoice — custom "Hey Esi" wake word
PICOVOICE_ACCESS_KEY=

# Ollama — local fast inference (Llama 3.1 8B)
OLLAMA_HOST=http://localhost:11434

# Whisper.cpp model size (base.en | small.en)
WHISPER_MODEL=base.en

# macOS voice for `say` output
ESI_VOICE=Zoe

# Startup HUD mode
ESI_DEFAULT_MODE=fullscreen
