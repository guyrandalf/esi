# ESI configuration — loaded from ~/Library/Application Support/ESI/.env
# when the packaged app runs. Edit to taste, then restart ESI.

# Gemini 2.0 Flash — heavy reasoning, vision, meeting summaries
GEMINI_API_KEY=

# Picovoice — custom "Hey ESI" wake word (optional; VAD+Whisper is used if empty)
PICOVOICE_ACCESS_KEY=

# Ollama — local fast inference (Llama 3.1 8B, etc.)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Whisper.cpp model — `small` is multilingual (better for non-US accents).
# Others: tiny, base, base.en, small, small.en, medium, large-v3
WHISPER_MODEL=small

# macOS voice for `say` output. Try Ava (Enhanced), Evan (Enhanced), Joelle, Samantha (Enhanced).
ESI_VOICE=Ava (Enhanced)

# How ESI starts: `menubar` (background, summon with wake word) or `window`.
# Blank → menubar when packaged, window in dev.
ESI_START_MODE=

# Wake backend: `vad` (Whisper-based, free) or `porcupine` (needs key above) or `off`.
# Blank → auto: porcupine if key is set, else vad.
ESI_WAKE=
